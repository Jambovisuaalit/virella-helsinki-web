# Keep previews and staging deployments out of search indexes by default.
SITE_INDEXABLE=false

# Add only when a canonical production domain is intentionally attached later.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Stripe test mode only until production migration is explicitly approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase persistence. Production Vercel functions authenticate to Supabase Edge Functions with VERCEL_OIDC_TOKEN.
SUPABASE_URL=

# Transactional email. Sender must be a verified Resend sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin access. Use a long random secret in Vercel Environment Variables.
ADMIN_ACCESS_TOKEN=
