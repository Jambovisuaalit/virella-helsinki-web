# Keep previews and staging deployments out of search indexes by default.
SITE_INDEXABLE=false

# Canonical production domain.
# NEXT_PUBLIC_SITE_URL=https://virellahelsinki.com

# Stripe. Production checkout stays fail-closed until LIVE_CHECKOUT_ENABLED=true,
# the live secret key is configured, and the live webhook signing secret is verified.
LIVE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
# Legacy fallback only; prefer the explicit TEST/LIVE variables above.
STRIPE_WEBHOOK_SECRET=

# Supabase persistence. Production Vercel functions authenticate to Supabase Edge Functions with Vercel OIDC.
SUPABASE_URL=

# Transactional email. Sender must be a verified Resend sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin access. Use a long random secret in Vercel Environment Variables.
ADMIN_ACCESS_TOKEN=
